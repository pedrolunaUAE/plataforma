# Copiar a .env. No subir .env al repositorio.

# Superusuario del Postgres compartido
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_ESTA_CONTRASENA

# Puerto publicado en Windows.
POSTGRES_PORT=5433

# Unico servidor web. El 80 esta libre mientras MxSIG no este levantado.
WEB_PORT=80

# Base y usuario del proyecto OVIE, dentro del mismo Postgres
OVIE_DB_NAME=ovie
OVIE_DB_USER=ovie
OVIE_DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA

# Lectura del visor IPLANAY. Solo puede consultar esa base.
IPLANAY_DB_USER=iplanay_lectura
IPLANAY_DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA

# Carpeta del cliente OVIE que el nginx comparte
OVIE_CLIENT_DIR=./proyectos/ovie/ovie-client

# Carpeta de los clientes de MxSIG
MXSIG_CLIENT_DIR=./proyectos/mxsig/clientes

# pgAdmin. Se abre por el proxy, en http://localhost/pgadmin/
PGADMIN_EMAIL=admin@plataforma.com
PGADMIN_PASSWORD=CAMBIAR_ESTA_CONTRASENA
